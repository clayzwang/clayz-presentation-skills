{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:layout-contract-instance:1.0",
  "title": "Clayz Layout Contract task-local instance",
  "type": "object",
  "required": ["contract", "instance_id", "layout_contract_id", "semantic_layout_tree_id", "frame", "bindings"],
  "properties": {
    "contract": {"const": "io.clayz.presentation.layout-contract-instance/1.0"},
    "instance_id": {"type": "string", "minLength": 1},
    "layout_contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "semantic_layout_tree_id": {"type": "string", "minLength": 1},
    "frame": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "content_kind", "copy_ids", "semantic_node_ids"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "content_kind": {"enum": ["text", "chart", "table", "diagram", "image", "source-note", "mixed"]},
          "copy_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "semantic_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
