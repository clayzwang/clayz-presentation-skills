        },
        "mapping": {
          "first_visual_role": "approved hero proposition",
          "backbone_relation": "one proposition is supported by an evidence cluster",
          "reading_path": "hero proposition to evidence cluster to closing qualification",
          "spatial_rules": [
            {
              "semantic_relation": "supports",
              "spatial_behavior": "group evidence near the proposition without equalizing its visual weight"
            },
            {
              "semantic_relation": "qualifies",
              "spatial_behavior": "keep qualifications visually subordinate but readable"
            }
