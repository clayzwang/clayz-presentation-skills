      "metadata": {
        "contract": "io.clayz.presentation.composition-pattern/1.0",
        "composition_pattern_id": "pattern.asymmetric-evidence-to-decision",
        "revision": "1",
        "title": "Asymmetric evidence to decision",
        "summary": "A dominant evidence field supports a smaller but visually decisive implication without reducing the page to equal cards.",
        "selection": {
          "task_modes": [
            "new-build",
            "redesign"
          ],
          "page_roles": [
            "comparison"
          ],
          "semantic_relations": [
