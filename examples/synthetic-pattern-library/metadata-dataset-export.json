            "evidence-led"
          ],
          "languages": [
            "en-US",
            "zh-CN"
          ]
        },
        "mapping": {
          "first_visual_role": "primary evidence",
          "backbone_relation": "evidence supports decision implication",
          "reading_path": "dominant evidence to supporting findings to decision implication",
          "spatial_rules": [
            {
              "semantic_relation": "supports",
              "spatial_behavior": "allocate more area to evidence while keeping the implication visually final"
            },
            {
              "semantic_relation": "compares",
              "spatial_behavior": "preserve comparable evidence scales inside the dominant field"
            }
          ],
          "object_hierarchy": [
            "primary evidence",
            "supporting findings",
            "decision implication",
            "source note"
          ]
        },
        "applicability": {
          "requires": [
            "one evidence object is the approved first visual",
            "a decision implication is supported by that evidence"
          ],
          "avoid_when": [
            "both sides are independent peer decisions",
            "evidence is absent or unverified"
          ]
        },
        "failure_pattern_ids": [
