{
  "contract": "io.clayz.presentation.composition-pattern/1.0",
  "composition_pattern_id": "pattern.asymmetric-evidence-to-decision",
  "revision": "1",
  "title": "Asymmetric evidence to decision",
  "summary": "A dominant evidence field supports a smaller but visually decisive implication without reducing the page to equal cards.",
  "selection": {
    "task_modes": ["new-build", "redesign"],
    "page_roles": ["comparison"],
    "semantic_relations": ["supports"],
    "purpose_tags": ["evidence-led"],
    "languages": ["en-US", "zh-CN"]
  },
  "mapping": {
    "first_visual_role": "primary evidence",
    "backbone_relation": "evidence supports decision implication",
    "reading_path": "dominant evidence to supporting findings to decision implication",
    "spatial_rules": [
      {"semantic_relation": "supports", "spatial_behavior": "allocate more area to evidence while keeping the implication visually final"},
      {"semantic_relation": "compares", "spatial_behavior": "preserve comparable evidence scales inside the dominant field"}
    ],
    "object_hierarchy": ["primary evidence", "supporting findings", "decision implication", "source note"]
  },
  "applicability": {
    "requires": ["one evidence object is the approved first visual", "a decision implication is supported by that evidence"],
    "avoid_when": ["both sides are independent peer decisions", "evidence is absent or unverified"]
  },
  "failure_pattern_ids": ["failure.equal-weight-flattening", "failure.semantic-visual-mismatch"],
  "decision_contract": {
    "selection_reason_required": true,
    "rejection_reason_required": true,
    "constraints_required": true,
    "expected_visual_effect_required": true
  },
  "guards": {
    "brand_neutral": true,
    "original_method": true,
    "theme_independent": true,
    "visual_variant_independent": true,
    "layout_contract_independent": true,
    "coordinates_deferred": true,
    "editable_objects_required": true,
    "flattened_output_forbidden": true,
    "no_embedded_assets": true
  }
}
