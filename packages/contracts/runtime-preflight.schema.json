{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:runtime-preflight:1.0",
  "title": "Clayz locked runtime preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "scan_id", "created_at", "platform", "model", "required_capabilities", "dependencies", "selected_route", "fallback_routes", "budgets", "guards", "warnings"],
  "properties": {
    "contract": {"const": "io.clayz.presentation.runtime-preflight/1.0"},
    "scan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "platform": {"type": "object"},
    "model": {
      "type": "object",
      "required": ["profile", "label", "interaction_mode", "requires"],
      "properties": {
        "profile": {"enum": ["A", "B", "C", "D"]},
        "label": {"type": "string"},
        "interaction_mode": {"type": "string"},
        "requires": {"type": "array", "items": {"type": "string"}}
      }
    },
    "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "object"},
    "selected_route": {
      "type": "object",
      "required": ["route_id", "authoring_backend", "render_backend", "available", "missing_capabilities", "host_model_private_tool_required", "locked"],
      "properties": {
        "route_id": {"type": "string"},
        "authoring_backend": {"enum": ["native-presentation-tool", "python-pptx", "artifact-tool", "powerpoint-com", "spec-only"]},
        "render_backend": {"enum": ["native-presentation-tool", "powerpoint-com", "libreoffice", "artifact-tool", "none"]},
        "available": {"type": "boolean"},
        "missing_capabilities": {"type": "array", "items": {"type": "string"}},
        "host_model_private_tool_required": {"type": "boolean"},
        "locked": {"const": true}
      }
    },
    "fallback_routes": {"type": "array", "items": {"type": "object"}},
    "budgets": {"type": "object"},
    "guards": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
