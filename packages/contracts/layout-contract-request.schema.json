{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:layout-contract-request:1.0",
  "title": "Clayz Layout Contract resolution request",
  "type": "object",
  "required": ["contract", "request_id", "task_mode", "page_role", "semantic_relations", "purpose_tags", "language", "rights_context", "provider_ids"],
  "properties": {
    "contract": {"const": "io.clayz.presentation.layout-contract-request/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "task_mode": {"type": "string", "minLength": 1},
    "page_role": {"type": "string", "minLength": 1},
    "semantic_relations": {"$ref": "#/$defs/stringSet"},
    "purpose_tags": {"$ref": "#/$defs/stringSet"},
    "language": {"type": "string", "minLength": 1},
    "rights_context": {"enum": ["public-open-source", "private-runtime"]},
    "provider_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "preferred_contract_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
  },
  "$defs": {"stringSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
  "additionalProperties": false
}
