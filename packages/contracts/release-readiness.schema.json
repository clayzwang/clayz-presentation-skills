{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:release-readiness:1.0",
  "title": "Clayz release authorization record",
  "type": "object",
  "required": ["contract", "target_version", "current_public_version", "state", "stage_gates", "actions", "authorization", "evidence", "guards"],
  "properties": {
    "contract": {"const": "io.clayz.presentation.release-readiness/1.0"},
    "target_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "current_public_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "state": {"enum": ["release-authorized", "local-build-authorized"]},
    "stage_gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "actions": {
      "type": "object",
      "required": ["merge", "tag", "publish", "experience_center_update"],
      "properties": {
        "merge": {"type": "boolean"},
        "tag": {"type": "boolean"},
        "publish": {"type": "boolean"},
        "experience_center_update": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["decision", "authorized_at", "scope"],
      "properties": {
        "decision": {"enum": ["explicit-user-authorization", "explicit-user-restriction"]},
        "authorized_at": {"type": "string", "format": "date-time"},
        "scope": {"enum": ["merge-tag-publish-experience-center", "local-build-no-github-push"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["benchmark_report", "migration_report", "validation_command"],
      "properties": {
        "benchmark_report": {"type": "string", "minLength": 1},
        "migration_report": {"type": "string", "minLength": 1},
        "validation_command": {"type": "string", "minLength": 1},
        "experience_validation": {"type": "string", "minLength": 1},
        "presentation_overflow_check": {"type": "string", "minLength": 1},
        "node_chart_build": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "guards": {
      "type": "object",
      "required": ["no_unlicensed_assets", "no_private_brand_assets", "no_generated_auto_admission", "no_automatic_aesthetic_truth", "release_requires_separate_human_authorization"],
      "properties": {
        "no_unlicensed_assets": {"const": true},
        "no_private_brand_assets": {"const": true},
        "no_generated_auto_admission": {"const": true},
        "no_automatic_aesthetic_truth": {"const": true},
        "release_requires_separate_human_authorization": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
