{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:metadata-dataset-export:1.0",
  "title": "Clayz metadata-only dataset export",
  "type": "object",
  "required": ["contract", "dataset_id", "created_at", "provider_snapshot", "record_types", "records", "guards"],
  "properties": {
    "contract": {"const": "io.clayz.presentation.metadata-dataset-export/1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "provider_snapshot": {
      "type": "object",
      "required": ["provider_id", "digest", "record_count"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "record_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["composition-pattern", "failure-pattern", "reference", "sequence"]}},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "record_type", "source_id", "source_revision", "source_sha256", "classification", "metadata"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "record_type": {"enum": ["composition-pattern", "failure-pattern", "reference", "sequence"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "classification": {"type": "object"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "guards": {
      "type": "object",
      "required": ["only_registered_records", "human_admitted_only", "public_catalog_only", "metadata_only", "no_asset_bytes", "no_raw_source_text", "no_coordinates", "no_fonts", "no_model_weights", "generated_artifacts_auto_admitted", "automatic_aesthetic_truth"],
      "properties": {
        "only_registered_records": {"const": true},
        "human_admitted_only": {"const": true},
        "public_catalog_only": {"const": true},
        "metadata_only": {"const": true},
        "no_asset_bytes": {"const": true},
        "no_raw_source_text": {"const": true},
        "no_coordinates": {"const": true},
        "no_fonts": {"const": true},
        "no_model_weights": {"const": true},
        "generated_artifacts_auto_admitted": {"const": false},
        "automatic_aesthetic_truth": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
