{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clayz:presentation:schema:config:1.0",
  "title": "Clayz Presentation Skills configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "workflow", "locale", "theme", "layout", "references", "renderer", "delivery", "qa"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version", "creator", "brand", "namespace", "attribution"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "creator": {"const": "clayz"},
        "brand": {"const": "clayz"},
        "namespace": {"const": "io.clayz.presentation"},
        "attribution": {"type": "object"}
      }
    },
    "workflow": {
      "type": "object",
      "required": ["contract_version", "stages", "approval_states"]
    },
    "locale": {"type": "object"},
    "theme": {
      "type": "object",
      "required": ["profile", "source", "slide_size", "layout_roles", "colors", "typography"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "source": {"enum": ["generated", "user-master"]},
        "master_path": {"type": ["string", "null"]},
        "slide_size": {"type": "string", "minLength": 1},
        "layout_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "colors": {"type": "object"},
        "typography": {
          "type": "object",
          "required": ["primary_fonts", "body_minimum_pt", "minimum_audience_text_pt", "minimum_chart_text_pt", "prefer_even_point_sizes", "allow_fractional_point_sizes", "minimum_exception_policy", "fail_on_missing_primary_font"],
          "properties": {
            "primary_fonts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "body_minimum_pt": {"type": "number", "exclusiveMinimum": 0},
            "minimum_audience_text_pt": {"type": "number", "exclusiveMinimum": 0},
            "minimum_chart_text_pt": {"type": "number", "exclusiveMinimum": 0},
            "prefer_even_point_sizes": {"type": "boolean"},
            "allow_fractional_point_sizes": {"type": "boolean"},
            "minimum_exception_policy": {"type": "string", "minLength": 1},
            "fail_on_missing_primary_font": {"type": "boolean"}
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["column_count", "safe_margin_in", "title_zone_height_in", "footer_zone_height_in", "minimum_gap_in", "maximum_horizontal_nodes", "cardification_policy"],
      "properties": {
        "column_count": {"type": "integer", "minimum": 1},
        "safe_margin_in": {"type": "number", "minimum": 0},
        "title_zone_height_in": {"type": "number", "minimum": 0},
        "footer_zone_height_in": {"type": "number", "minimum": 0},
        "minimum_gap_in": {"type": "number", "minimum": 0},
        "maximum_horizontal_nodes": {"type": "integer", "minimum": 1},
        "cardification_policy": {"type": "string", "minLength": 1}
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "roots", "registry", "admission_registry", "learning", "require_human_admission", "allow_external_search", "maximum_unique_examples_per_deck"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "registry": {"type": "string", "minLength": 1},
        "admission_registry": {"type": "string", "minLength": 1},
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "stages", "writeback_mode", "auto_promote", "contract"],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "stages": {"const": ["logic", "copy", "art-direction", "output"]},
            "writeback_mode": {"const": "append-observation-only"},
            "auto_promote": {"const": false},
            "contract": {"const": "packages/contracts/knowledge-learning.md"}
          }
        },
        "require_human_admission": {"const": true},
        "allow_external_search": {"type": "boolean"},
        "maximum_unique_examples_per_deck": {"type": "integer", "minimum": 1}
      }
    },
    "renderer": {"type": "object"},
    "delivery": {"type": "object"},
    "qa": {"type": "object"}
  }
}
